  <dialog class="video-dialog" data-video-dialog aria-label="Expanded experiment video" data-aria-zh="放大播放实验视频" data-aria-en="Expanded experiment video">
    <div class="dialog-header">
      <span>LEROBOT / EXPERIMENT VIEW</span>
      <button type="button" data-close-dialog aria-label="Close video" data-aria-zh="关闭视频" data-aria-en="Close video">
        <svg viewBox="0 0 20 20" aria-hidden="true"><path d="m5 5 10 10M15 5 5 15" /></svg>
      </button>
    </div>
    <video controls playsinline preload="none" data-dialog-video></video>
  </dialog>

  <script>
    const languageButtons = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-set-lang]'));
    const languageStorageKey = 'weiqi-resume-language';

    function setLanguage(language: 'zh' | 'en') {
      document.documentElement.dataset.lang = language;
      document.documentElement.lang = language === 'zh' ? 'zh-CN' : 'en';
      languageButtons.forEach((button) => {
        button.setAttribute('aria-pressed', String(button.dataset.setLang === language));
      });
      document.querySelectorAll<HTMLElement>('[data-aria-zh]').forEach((element) => {
        const label = language === 'en' ? element.dataset.ariaEn : element.dataset.ariaZh;
        if (label) element.setAttribute('aria-label', label);
      });
      document.title = language === 'zh'
        ? '盖巍奇 · 机器人导航与具身智能'
        : 'Weiqi Gai | Robotics & Embodied Intelligence';
      try {
        localStorage.setItem(languageStorageKey, language);
      } catch {}
      window.dispatchEvent(new CustomEvent('resume-language-change'));
    }

    let storedLanguage: string | null = null;
    try {
      storedLanguage = localStorage.getItem(languageStorageKey);
    } catch {}
    setLanguage(storedLanguage === 'zh' ? 'zh' : 'en');
    languageButtons.forEach((button) => {
      button.addEventListener('click', () => setLanguage(button.dataset.setLang === 'en' ? 'en' : 'zh'));
    });

    const header = document.querySelector<HTMLElement>('[data-site-header]');
    const updateHeader = () => header?.classList.toggle('is-scrolled', window.scrollY > 24);
    updateHeader();
    window.addEventListener('scroll', updateHeader, { passive: true });

    const player = document.querySelector<HTMLElement>('[data-sync-player]');
    if (player) {
      const videos = Array.from(player.querySelectorAll<HTMLVideoElement>('[data-sync-video]'));
      const playButton = player.querySelector<HTMLButtonElement>('[data-play-all]');
      const replayButton = player.querySelector<HTMLButtonElement>('[data-replay-all]');
      const progress = player.querySelector<HTMLInputElement>('[data-video-progress]');
      const currentTime = player.querySelector<HTMLElement>('[data-current-time]');
      const totalTime = player.querySelector<HTMLElement>('[data-total-time]');
      const playbackError = player.querySelector<HTMLElement>('[data-playback-error]');
      let playing = false;
      let frame = 0;
      let playRequest = 0;

      const formatTime = (value: number) => {
        const minutes = Math.floor(value / 60);
        const seconds = Math.floor(value % 60);
        return `${String(minutes).padStart(2, '0')}:${String(seconds).padStart(2, '0')}`;
      };
      const setPlaying = (value: boolean) => {
        playing = value;
        player.dataset.playing = String(value);
        const english = document.documentElement.dataset.lang === 'en';
        playButton?.setAttribute('aria-label', value
          ? (english ? 'Pause all four videos' : '暂停全部四段视频')
          : (english ? 'Play all four videos in sync' : '同步播放全部四段视频'));
      };

      const updateTimeline = () => {
        const leader = videos[0];
        if (!leader || !progress || !currentTime) return;
        const duration = Number.isFinite(leader.duration) ? leader.duration : 15.2;
        progress.value = String(Math.round((leader.currentTime / duration) * 1000));
        currentTime.textContent = formatTime(leader.currentTime);

        if (playing) {
          videos.slice(1).forEach((video) => {
            if (!video.ended && Math.abs(video.currentTime - leader.currentTime) > 0.14) {
              video.currentTime = leader.currentTime;
            }
          });
          if (leader.ended || leader.currentTime >= duration - 0.05) {
            setPlaying(false);
          } else {
            frame = requestAnimationFrame(updateTimeline);
          }
        }
      };

      const playAll = async () => {
        if (playbackError) playbackError.hidden = true;
        if (videos.some(video => !video.canPlayType('video/mp4; codecs="avc1.42E01E"'))) {
          if (playbackError) playbackError.hidden = false;
          return;
        }
        const request = ++playRequest;
        const leader = videos[0];
        if (leader && leader.ended) videos.forEach((video) => { video.currentTime = 0; });
        setPlaying(true);
        cancelAnimationFrame(frame);
        frame = requestAnimationFrame(updateTimeline);
        const results = await Promise.allSettled(videos.map((video) => video.play()));
        if (request !== playRequest) return;
        if (results.some((result) => result.status === 'rejected')) {
          pauseAll();
          if (playbackError) playbackError.hidden = false;
        }
      };

      const pauseAll = () => {
        playRequest += 1;
        videos.forEach((video) => video.pause());
        setPlaying(false);
        cancelAnimationFrame(frame);
        updateTimeline();
      };

      videos.forEach(video => {
        const reportError = () => {
          pauseAll();
          if (playbackError) playbackError.hidden = false;
        };
        video.addEventListener('error', reportError);
        video.querySelector('source')?.addEventListener('error', reportError);
      });

      playButton?.addEventListener('click', () => playing ? pauseAll() : void playAll());
      replayButton?.addEventListener('click', () => {
        videos.forEach((video) => { video.currentTime = 0; });
        void playAll();
      });
      progress?.addEventListener('input', () => {
        const target = (Number(progress.value) / 1000) * (videos[0]?.duration || 15.2);
        videos.forEach((video) => { video.currentTime = target; });
        updateTimeline();
      });
      videos[0]?.addEventListener('loadedmetadata', () => {
        updateTimeline();
        if (totalTime && videos[0]) totalTime.textContent = formatTime(videos[0].duration);
      }, { once: true });
      window.addEventListener('resume-language-change', () => setPlaying(playing));

      const observer = new IntersectionObserver(([entry]) => {
        if (!entry.isIntersecting && playing) pauseAll();
      }, { threshold: 0.05 });
      observer.observe(player);
      document.addEventListener('visibilitychange', () => {
        if (document.hidden && playing) pauseAll();
      });

      const dialog = document.querySelector<HTMLDialogElement>('[data-video-dialog]');
      const dialogVideo = dialog?.querySelector<HTMLVideoElement>('[data-dialog-video]');
      const closeDialog = () => {
        dialogVideo?.pause();
        if (dialogVideo) {
          dialogVideo.removeAttribute('src');
          dialogVideo.removeAttribute('poster');
          dialogVideo.load();
        }
        dialog?.close();
      };

      player.querySelectorAll<HTMLButtonElement>('[data-expand-video]').forEach((button) => {
        button.addEventListener('click', () => {
          pauseAll();
          if (!dialog || !dialogVideo) return;
          dialogVideo.src = button.dataset.videoSrc || '';
          dialogVideo.poster = button.dataset.videoPoster || '';
          dialog.showModal();
        });
      });
      dialog?.querySelector<HTMLButtonElement>('[data-close-dialog]')?.addEventListener('click', closeDialog);
      dialog?.addEventListener('click', (event) => {
        if (event.target === dialog) closeDialog();
      });
      dialog?.addEventListener('close', () => dialogVideo?.pause());
    }
  </script>
</Layout>
